# Normalise all text files to LF so shell scripts and configs work on Linux servers,
# even when the repo is checked out on Windows.
* text=auto eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.woff binary
*.woff2 binary
