# ---------------------------------------------------------------------------
# Bootstrap settings only. Everything else (mode, public domain, AI models,
# clients, ...) is configured in the admin UI and stored in the database.
# install.sh creates .env from this template with random secrets.
# ---------------------------------------------------------------------------

# Database (used by the db container and by the app/worker)
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://chatbot:change-me@db:5432/chatbot

# Encrypts stored API keys and signs sessions. NEVER change or lose it after
# setup: encrypted AI-model API keys would become unreadable.
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Ports: public chat API + widget, and the admin UI.
APP_PORT=8000
ADMIN_PORT=8001

# ---- Optional ----------------------------------------------------------------
# Host interface the ports are published on. Set ADMIN_BIND_IP=127.0.0.1 to keep
# the admin UI internal-only (e.g. on-premise behind a VPN / SSH tunnel).
APP_BIND_IP=0.0.0.0
ADMIN_BIND_IP=0.0.0.0

# Proxy IPs whose X-Forwarded-* headers are trusted. Set to * only when the ports
# are not reachable directly (e.g. HTTPS profile with APP_BIND_IP=127.0.0.1).
FORWARDED_ALLOW_IPS=127.0.0.1

# Host folder mounted read-only at /mnt/watched inside the containers. Watched
# document folders (and mounted network shares) must live under it.
WATCHED_HOST_DIR=./watched

LOG_LEVEL=INFO

# OCR for scanned PDFs. Languages installed: eng, mal, hin, ara. Join with + (e.g. eng+mal);
# each extra language slows OCR down, so list only the ones your documents use.
OCR_LANGS=eng
# Pages OCR'd in parallel (0 = one per CPU core).
OCR_WORKERS=0
# Resolution scans are read at: 200 is fast and fine for normal print, 300 for very small print.
OCR_DPI=200

# Install test tools into the image (development only).
INSTALL_DEV=false

# ---- NVIDIA GPU (optional, see README "GPU acceleration") -------------------
# PyTorch build in the image: cpu, or cu124 for NVIDIA GPUs. With cu124 also
# uncomment COMPOSE_FILE (use ; instead of : as the separator on Windows),
# rebuild, and choose GPU in Settings -> Compute device.
TORCH_VARIANT=cpu
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# ---- HTTPS profile (docker compose --profile https up -d) --------------------
# Caddy obtains Let's Encrypt certificates automatically. DNS must point here.
HTTPS_PUBLIC_DOMAIN=
HTTPS_ADMIN_DOMAIN=
