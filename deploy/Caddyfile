# Reverse proxy with automatic HTTPS (Let's Encrypt), used by the "https" compose profile.
# Domains come from .env: HTTPS_PUBLIC_DOMAIN (required) and HTTPS_ADMIN_DOMAIN (optional).

# Public chat API + widget.js
{$HTTPS_PUBLIC_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:{$APP_PORT}
}

# Admin UI. Without HTTPS_ADMIN_DOMAIN this falls back to "localhost" (local-only),
# so the admin UI is not exposed publicly unless you choose a domain for it.
{$HTTPS_ADMIN_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy app:{$ADMIN_PORT}
}
